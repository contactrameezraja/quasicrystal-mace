#!/bin/bash
#SBATCH --job-name=mace-md
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem-per-cpu=3700
#SBATCH --gres=gpu:1
#SBATCH --time=24:00:00
#SBATCH --output=md-%j.out

# Usage:
#   sbatch submit_md.sb --benchmark
#   sbatch submit_md.sb --supercell 2 --steps 15000     # 30 ps, matches the laptop run
#   sbatch submit_md.sb --supercell 3 --steps 50000     # 100 ps
#   sbatch submit_md.sb --supercell 4 --steps 100000    # 200 ps
#
# Set --time above from the benchmark projection, with headroom. Velocities are
# saved block-by-block, so a walltime kill keeps everything up to the last block.

# PIP-PyTorch needs the GCC/OpenMPI toolchain loaded first, otherwise it is not
# visible to `module load`. Confirmed on Avon.
module purge
module load GCC/13.2.0
module load OpenMPI/4.1.6
module load PIP-PyTorch/2.4.0-CUDA-12.4.0

cd ~/quasicrystal

python -c "import torch; print('CUDA:', torch.cuda.is_available(), torch.cuda.get_device_name(0))"
python md_run.py --device cuda "$@"
