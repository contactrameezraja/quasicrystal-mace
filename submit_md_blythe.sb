#!/bin/bash
#SBATCH --job-name=mace-md
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --gres=gpu:lovelace_l40:1
#SBATCH --time=48:00:00
#SBATCH --output=md-%j.out
module purge
module load PIP-PyTorch/2.4.0-foss-2023b-CUDA-12.4.0
cd $SLURM_SUBMIT_DIR
python -c "import torch; print('CUDA:', torch.cuda.is_available(), torch.cuda.get_device_name(0)); print('GPU memory GB:', round(torch.cuda.get_device_properties(0).total_memory/1e9,1))"
python md_run.py --device cuda "$@"
